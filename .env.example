DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_companion
# Managed/cloud PostgreSQL usually needs TLS: set DB_SSLMODE=require there (leave empty locally).
# DB_SSLMODE=require

JWT_SECRET_KEY=replace_with_a_long_random_secret_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_gmail@gmail.com
SMTP_PASSWORD=your_google_app_password
MAIL_FROM=your_sender_gmail@gmail.com

APP_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed by CORS (no "*").
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Separate database used only by the test suite (must end in _test).
TEST_DB_NAME=career_companion_test

# Local embedding model (downloaded once with
# `python -m backend.manage download-embedding-model`, then used offline).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_CACHE_DIR=.models

# FAISS index folder (rebuilt from PostgreSQL; gitignored).
FAISS_INDEX_DIR=backend/data/faiss_index

# Optional AI-assisted writing (Phase 5). Disabled unless LLM_PROVIDER=groq
# AND GROQ_API_KEY are set; students must still opt in per document.
# Name and contact details are never sent to the provider.
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Local alternative to Groq (LLM_PROVIDER=ollama). Runs on this machine; nothing leaves it.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3
# OLLAMA_TIMEOUT_SECONDS=120

# Email delivery: outbox (default, writes .eml files, sends nothing) | smtp | disabled.
EMAIL_MODE=outbox
# EMAIL_OUTBOX_DIR=uploads/email_outbox
MAIL_FROM_NAME=CareerNova AI
# starttls (port 587) or ssl (port 465)
SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=15
# Address of the web app used in invitation / reset / verification links.
FRONTEND_URL=http://localhost:5173
